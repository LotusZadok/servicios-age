# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.branches
supabase/.temp

# Ad-hoc secret-key probe (contains secret when filled) - never commit
test-secret.mjs

# Pre-publish history audit - local report, not for the repo
AUDIT.md

# Configuración de herramientas locales
CLAUDE.md
AGENTS.md
.claude/
.mcp.json

# Contexto interno: ref de Supabase, estado comercial y análisis de términos de
